generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ARTISAN
  BUYER
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role
  accountStatus  String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  artisanProfile ArtisanProfile?
  craftItems     CraftItem[]
  schemeApplications SchemeApplication[]
  notifications  Notification[]
  ivrDummyItems  IvrDummyItem[]
  orders         Order[]         @relation("BuyerOrders")

  // Admin fields
  patchBankBalance Int @default(5000)
  patchBankIssued  Int @default(0)

  // Buyer fields (optional, only for BUYER role)
  businessName     String?
  gstNumber        String?
  phoneNumber      String?
  shippingAddress  String?
}

model ArtisanProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  craftType       String
  location        String
  mobileNumber    String?
  experienceYears Int
  cooperativeId   String?
  photoUrl        String?
  upiId           String?
  description     String?
  tags            String[]
  healthScore     Float    @default(100)

  socialCategory  String?
  annualIncome    Float?
  aadhaarLast4    String?
  clusterName     String?
  giTagCertified  Boolean  @default(false)
  giTagName       String?

  @@index([socialCategory])
}

model CraftItem {
  id                  String   @id @default(uuid())
  artisanId           String
  artisan             User     @relation(fields: [artisanId], references: [id])
  patchId             String?
  craftType           String
  inventory           Int      @default(1)
  descriptionOriginal String?
  descriptionEnglish  String?
  tags                String[]
  images              String[]
  rawMaterialProofUrl String?
  rawMaterialCost     Float?
  laborDays           Int?
  fairnessScore       Float?
  fairWageFloor       Float?
  marketPriceMin      Float?
  marketPriceMax      Float?
  standardMarketPrice Float?
  /** The price the artisan chose to list at. Null on rows captured before price-setting existed. */
  askingPrice         Float?
  creditScore         Float?
  status              String   @default("Pending")
  advancePaid         Float    @default(0)
  finalPayoutQueued   Float    @default(0)
  salePrice           Float?
  assignedAdminId     String?
  createdAt           DateTime @default(now())
  firstFailedScanAt   DateTime?
  failedScanCount     Int      @default(0)

  aiGeneratedListing   String?
  aiSuggestedCategory  String?
  giTagApplied         String?
  isListedOnMarketplace Boolean @default(false)

  // Anti-exploitation pricing guardian (new_admin.md Tier 1.1)
  pricingFlag         Boolean  @default(false)
  flagReason          String?

  // Digital-inclusion telemetry (new_admin.md Tier 2.1)
  catalogMethod       String?  // "VOICE" | "MANUAL"
  voiceLanguage       String?  // "Odia" | "Hindi" | "Telugu" | "English"
  audioUrl            String?  // optional; null for legacy rows

  auditLogs           AuditLog[]
  orders              Order[]

  @@index([artisanId])
  @@index([patchId])
  @@index([status])
  @@index([createdAt])
  @@index([pricingFlag])
}

model AuditLog {
  id            String    @id @default(uuid())
  craftItemId   String
  craftItem     CraftItem @relation(fields: [craftItemId], references: [id])
  actorId       String?
  actorRole     String
  action        String
  previousState Json?
  newState      Json?
  comments      String?
  createdAt     DateTime  @default(now())
}

model SchemeApplication {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  /// Stable key from src/lib/schemes.ts (SchemeKey). Replaces fuzzy name matching.
  schemeKey  String?
  schemeName String
  status     String    @default("ELIGIBLE")
  appliedAt  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, schemeKey])
}


/// Buyer-posted bulk requirement. Public board: buyers have no account in this
/// app yet, so a demand carries a free-text `buyerName` instead of a userId.
model Demand {
  id              String   @id @default(uuid())
  craftType       String
  quantity        Int
  targetPriceMin  Float?
  targetPriceMax  Float?
  location        String?
  festival        String?
  buyerName       String?
  notes           String?
  status          String   @default("OPEN") // OPEN | MATCHED | FULFILLED
  createdAt       DateTime @default(now())

  @@index([craftType])
  @@index([status])
  @@index([createdAt])
}

/// In-app alert for one artisan. Written by the insights engine when a matching
/// demand lands or a relevant festival is near; read by the header bell and
/// replayed by the WhatsApp/SMS simulation.
model Notification {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String   // DEMAND_ALERT | FESTIVAL | SCHEME | SYSTEM
  title           String
  message         String
  read            Boolean  @default(false)
  relatedDemandId String?
  channel         String?  // WHATSAPP | SMS | IN_APP
  createdAt       DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

/// Dummy holding area for items reported via the Toll-Free AI IVR.
/// These require SHG photo capture via the CaptureModal to enter live inventory.
model IvrDummyItem {
  id              String   @id @default(uuid())
  artisanId       String
  artisan         User     @relation(fields: [artisanId], references: [id])
  transcript      String
  craftType       String
  laborDays       Int
  rawMaterialCost Float
  status          String   @default("PENDING_CAPTURE") // PENDING_CAPTURE | MIGRATED
  createdAt       DateTime @default(now())

  @@index([artisanId])
  @@index([status])
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  VERIFIED
}

/// Marketplace order placed by a BUYER for a specific CraftItem.
model Order {
  id              String      @id @default(uuid())
  buyerId         String
  buyer           User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  craftItemId     String
  craftItem       CraftItem   @relation(fields: [craftItemId], references: [id])
  quantity        Int         @default(1)
  totalPrice      Float
  status          OrderStatus @default(PLACED)
  shippingAddress String?
  paymentMethod   String?     // "UPI_SIMULATED" | "COD"
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([buyerId])
  @@index([craftItemId])
  @@index([status])
}
